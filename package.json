{
  "name": "dsh-plugin-newsnow",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "description": "Hot-news reading panel for DeepSeek Harness, backed by the NewsNow (newsnext/newsnow) public API.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "news",
    "newsnow",
    "hot-news"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
